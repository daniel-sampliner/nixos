+		const credential = await openaiCodexOAuth.login({
+			signal: neverAbortedSignal,
+			prompt: async (prompt) => {
+				prompts.push(prompt.type);
+				if (prompt.type === "select") return "device_code";
+				throw new Error(`Unexpected prompt: ${prompt.type}`);
+			},
+			notify: () => {},
+		});
+		expect(prompts).toEqual(["select"]);
+		expect(credential).toMatchObject({ accountId: "device-account" });
+		expect(credential).not.toHaveProperty("accountIdOverride");
+	});
+
 	it("does not write token refresh failures to stderr", async () => {
 		const consoleError = vi.spyOn(console, "error").mockImplementation(() => {});
 		vi.stubGlobal(
