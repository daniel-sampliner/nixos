 			const grammarToolInputProperties = createGrammarToolInputProperties(
 				context.tools,
 				model.compat?.supportsOpenAIGrammarTools ?? false,
@@ -1576,6 +1576,23 @@ async function parseErrorResponse(response: Response): Promise<{ message: string
 // Auth & Headers
 // ============================================================================
 
+function resolveEffectiveAccountId(
+	initHeaders: Record<string, string> | undefined,
+	additionalHeaders: ProviderHeaders | undefined,
+	token: string,
+): string {
+	const configuredHeaders = new Headers(initHeaders);
+	for (const [key, value] of Object.entries(additionalHeaders || {})) {
+		if (value === null) {
+			configuredHeaders.delete(key);
+		} else {
+			configuredHeaders.set(key, value);
+		}
+	}
+	const explicitAccountId = configuredHeaders.get("chatgpt-account-id")?.trim();
+	return explicitAccountId || extractAccountId(token);
+}
+
 function extractAccountId(token: string): string {
 	try {
 		const parts = token.split(".");
diff --git a/packages/ai/src/auth/oauth/openai-codex.ts b/packages/ai/src/auth/oauth/openai-codex.ts
index 96e861a94..65112285c 100644
--- a/packages/ai/src/auth/oauth/openai-codex.ts
+++ b/packages/ai/src/auth/oauth/openai-codex.ts
@@ -400,8 +400,9 @@ function getAccountId(accessToken: string): string | null {
 	return typeof accountId === "string" && accountId.length > 0 ? accountId : null;
 }
 
-function credentialsFromToken(token: OAuthToken): OAuthCredential {
-	const accountId = getAccountId(token.access);
+function credentialsFromToken(token: OAuthToken, accountIdOverride?: string): OAuthCredential {
+	const normalizedOverride = typeof accountIdOverride === "string" ? accountIdOverride.trim() : undefined;
+	const accountId = normalizedOverride || getAccountId(token.access);
 	if (!accountId) {
 		throw new Error("Failed to extract accountId from token");
 	}
@@ -412,6 +413,7 @@ function credentialsFromToken(token: OAuthToken): OAuthCredential {
 		refresh: token.refresh,
 		expires: token.expires,
 		accountId,
+		...(normalizedOverride ? { accountIdOverride: normalizedOverride } : {}),
 	};
 }
 
@@ -420,8 +422,9 @@ async function exchangeAuthorizationCodeForCredentials(
 	verifier: string,
 	redirectUri: string,
 	signal: AbortSignal,
+	accountIdOverride?: string,
 ): Promise<OAuthCredential> {
-	return credentialsFromToken(await exchangeAuthorizationCode(code, verifier, redirectUri, signal));
+	return credentialsFromToken(await exchangeAuthorizationCode(code, verifier, redirectUri, signal), accountIdOverride);
 }
 
 async function loginOpenAICodexDeviceCode(interaction: ProviderAuthInteraction): Promise<OAuthCredential> {
@@ -443,6 +446,14 @@ async function loginOpenAICodexDeviceCode(interaction: ProviderAuthInteraction):
 }
 
 async function loginOpenAICodex(interaction: ProviderAuthInteraction): Promise<OAuthCredential> {
+	const accountIdOverride = (
+		await interaction.prompt({
+			type: "text",
+			message: "ChatGPT account ID (optional; blank to use the token claim):",
+		})
+	).trim();
+	if (interaction.signal.aborted) throw new Error("Login cancelled");
+
 	const { verifier, state, url } = await createAuthorizationFlow();
 	const server = await startLocalOAuthServer(state);
 	const manualAbort = new AbortController();
@@ -497,7 +508,13 @@ async function loginOpenAICodex(interaction: ProviderAuthInteraction): Promise<O
 		}
 
 		if (!code) throw new Error("Missing authorization code");
-		return exchangeAuthorizationCodeForCredentials(code, verifier, REDIRECT_URI, interaction.signal);
+		return exchangeAuthorizationCodeForCredentials(
+			code,
+			verifier,
+			REDIRECT_URI,
+			interaction.signal,
+			accountIdOverride || undefined,
+		);
 	} finally {
 		interaction.signal.removeEventListener("abort", onAbort);
 		manualAbort.abort();
@@ -508,8 +525,12 @@ async function loginOpenAICodex(interaction: ProviderAuthInteraction): Promise<O
 /**
  * Refresh OpenAI Codex OAuth token
  */
-async function refreshOpenAICodexToken(refreshToken: string, signal: AbortSignal): Promise<OAuthCredential> {
-	return credentialsFromToken(await refreshAccessToken(refreshToken, signal));
+async function refreshOpenAICodexToken(
+	refreshToken: string,
+	signal: AbortSignal,
+	accountIdOverride?: string,
+): Promise<OAuthCredential> {
+	return credentialsFromToken(await refreshAccessToken(refreshToken, signal), accountIdOverride);
 }
 
 export const openaiCodexOAuth: OAuthAuth = {
@@ -536,9 +557,19 @@ export const openaiCodexOAuth: OAuthAuth = {
 		return loginOpenAICodex(interaction);
 	},
 
-	refresh: (credential, signal) => refreshOpenAICodexToken(credential.refresh, signal),
+	refresh: (credential, signal) =>
+		refreshOpenAICodexToken(
+			credential.refresh,
+			signal,
+			typeof credential.accountIdOverride === "string" ? credential.accountIdOverride : undefined,
+		),
 
 	async toAuth(credential) {
-		return { apiKey: credential.access };
+		return {
+			apiKey: credential.access,
+			...(typeof credential.accountIdOverride === "string" && credential.accountIdOverride.trim().length > 0
+				? { headers: { "chatgpt-account-id": credential.accountIdOverride.trim() } }
+				: {}),
+		};
 	},
 };
diff --git a/packages/ai/test/oauth-auth.test.ts b/packages/ai/test/oauth-auth.test.ts
